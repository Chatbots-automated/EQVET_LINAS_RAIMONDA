NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser, never imported by client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: n8n invoice-OCR webhook URL for Pajamavimas PDF import.
NEXT_PUBLIC_INVOICE_WEBHOOK_URL=

# Server-only — AES-256-GCM key for per-tenant Invoice123 API tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be the same everywhere this Supabase DB is used (local + Netlify), or
# saved tokens can't be decrypted. Tokens themselves are entered per tenant in
# the app (Nustatymai → Sąskaita123), never put in env vars.
INVOICE123_TOKEN_ENCRYPTION_KEY=
